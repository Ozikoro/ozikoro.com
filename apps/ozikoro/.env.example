# Every environment variable this application reads, with what happens if it is unset.
#
# Copy to `.env.local` for development. `.env.local` is gitignored and must never be committed — it
# holds credentials.
#
# This file exists because it did not, and the two variables a deployment genuinely cannot start
# without (S3_BUCKET and HEALTH_TOKEN) were documented nowhere.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Where the archive's media lives. WITHOUT THIS the application falls back to the local filesystem,
# which is EPHEMERAL on a container platform: a redeploy leaves every row pointing at a key that no
# longer exists and all 3,488 images 404 at once. The media route refuses to serve from the local copy
# in production and logs the key it could not find, so the failure is loud rather than silent.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 and MinIO need path-style addressing; AWS S3 does not.
S3_FORCE_PATH_STYLE=0
# The public base URL for stored objects, if they are served through a CDN rather than this app.
MEDIA_PUBLIC_BASE_URL=

# Enables the detailed branch of GET /api/health (record counts). Without it the endpoint still
# answers and still checks the database; it just reports no numbers.
#
# A health endpoint is normally unauthenticated and world-readable, so counts are withheld from
# anonymous callers. The value is compared as a whole string, so knowing a prefix reveals nothing.
HEALTH_TOKEN=

# The origin, used for absolute URLs in sitemap entries and structured data.
OZITUMA_SITE_URL=https://ozikoro.com

# ---------------------------------------------------------------------------
# The database
# ---------------------------------------------------------------------------
# UNSET means the local PGlite cluster at .data/pg, which is what development uses.
#
# SET means a server Postgres. Note that PGlite and Postgres are not interchangeable for tooling:
# `npm run backup` REFUSES when DATABASE_URL is set, because copying a cluster directory is not a
# valid backup of a server Postgres — use pg_dump there.
DATABASE_URL=
DATABASE_POOL_MAX=10
# Only used with PGlite. Overrides the default .data/pg location.
OZITUMA_DB_PATH=
OZITUMA_DB_DEBUG=0

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# The cookie domain, for sharing a session across ozikoro.com, ozituma.com and learn.ozituma.com.
# One account table serves all three sites.
OZITUMA_AUTH_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Spotify (see docs/SPOTIFY.md)
# ---------------------------------------------------------------------------
# Only needed for the audio pipeline. The callback must be registered against the exact redirect URI
# for the environment — a mismatch is the usual cause of a failed connection.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_SCOPES=
# Random, and used to encrypt stored tokens. Changing it invalidates every existing connection.
SPOTIFY_TOKEN_KEY=

# ---------------------------------------------------------------------------
# Import tooling — not needed to run the application
# ---------------------------------------------------------------------------
# Several importers default to a DRY RUN. They only write when `--apply` is passed, and the notice
# saying so is a single line that an output filter can hide. Check the row counts afterwards.
OZITUMA_IMPORT_DRY_RUN=1
OZITUMA_IMPORT_LIMIT=
# Required by test suites that clear tables. Never set this in production.
OZITUMA_ALLOW_DESTRUCTIVE_TEST=0

# Source files for the dictionary imports, relative to data/.
OZITUMA_CLAN_FILE=
OZITUMA_IBODICT_SOURCE=
OZITUMA_IGBO_SOURCE=
OZITUMA_YORUBA_SOURCE=
OZITUMA_PROVERBS_SOURCE=
OZITUMA_CURATED_PROVERBS=
OZITUMA_MEANING_CORRECTIONS=
OZITUMA_NAMES_ROOT=
OZITUMA_WORD_ADDITIONS=
OZITUMA_GENERATED_EXAMPLES=
OZITUMA_PRACTICE_SAMPLES=
OZITUMA_EXAMPLES_NO_AUDIO=

# ---------------------------------------------------------------------------
# Legacy — read by code shared with the Ozituma application
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Read by @ozituma/core, which this application now depends on ---
#
# These are read inside the shared package rather than in this app, so the drift check did not see them
# until round 178 moved the SMTP client there. They are documented because the app's behaviour now depends
# on a package that reads them, whatever this app does with them itself.
#
# The name the SMTP client announces itself with. Cosmetic; a wrong value only shows up in a mail header.
OZITUMA_EHLO_NAME=
# Allow AUTH over an unencrypted socket. Off by default, and it should stay off: mail credentials on a
# plaintext connection are readable by anything on the path.
OZITUMA_SMTP_ALLOW_PLAINTEXT=0
# The Ndebe syllable table, used by the dictionary's courses. Listed because the shared package reads it;
# this application has no use for it and it can stay empty.
NDEBE_SYLLABLE_TABLE=

# NOWPayments — crypto donations
#
# THE IPN SECRET IS WHAT MAKES /api/webhooks/nowpayments TRUSTWORTHY. Unset, the endpoint answers 503 and
# records nothing, deliberately: an endpoint that accepts unsigned "payment finished" calls when a key is
# missing is worse than one that does not exist.
#
# The signature scheme is NOT Paystack's. Paystack signs the raw body bytes; NOWPayments signs the body
# RE-SERIALISED WITH ITS KEYS SORTED. So this route parses before it verifies, and an unparseable body is
# refused with 401 rather than acknowledged.
#
# The API key is used only for the independent confirmation: a valid signature proves NOWPayments sent the
# event, not that the payment finished, so the payment is re-checked against the API and that answer decides.
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SPOKEN RECORDS — an article read aloud in the owner's own voice
# ─────────────────────────────────────────────────────────────────────────────
#
# Spotify ingests an RSS feed, served from this site at /podcast/feed.xml. No host is required.
#
# NOTHING IS PUBLISHED WITHOUT A PERSON APPROVING IT. A rendered episode is held as `pending_review`
# and stays out of the feed until somebody listens and approves it.
ELEVENLABS_API_KEY=
# A voice cloned from the owner's own recordings. A cloned voice belongs to the person who trained it,
# which is why this takes an ID rather than shipping one.
ELEVENLABS_VOICE_ID_OWN=
# A stock narrator, for anything the owner has not recorded.
ELEVENLABS_VOICE_ID_GENERIC=
# Where the recordings used for training live. Defaults to ./data/voice-samples.
VOICE_SAMPLES_DIR=
