# Ozituma — TLS termination and reverse proxy.
#
# TLS uses a Cloudflare Origin CA certificate rather than Let's Encrypt. The
# domain is proxied by Cloudflare, so the certificate only ever has to be
# trusted by Cloudflare, and an Origin CA cert is issued for up to 15 years with
# no renewal job to run. That removes the whole class of failure where an
# unrenewed certificate takes the site down.
#
# Cloudflare's SSL mode must be "full (strict)" to match. Anything less and the
# Cloudflare-to-origin hop is unverified.

{
	admin off
	# Structured logs to stdout, where the container logging driver collects them.
	log {
		output stdout
		format json
	}
}

# Canonical host. www redirects to the apex so there is one address for the
# dictionary and no duplicate content for search engines.
www.{$OZITUMA_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	redir https://{$OZITUMA_DOMAIN}{uri} permanent
}

{$OZITUMA_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The framework is not something to advertise.
		-Server
	}

	# Health checks must never be cached, or an unhealthy origin can keep
	# reporting healthy to whatever is watching it.
	@health path /api/health
	header @health Cache-Control "no-store"

	# Nothing that is a page may be cached at the edge.
	#
	# The dictionary sends `no-store` itself, so it was never the problem. The courses send no
	# Cache-Control at all — and when an origin says nothing, Cloudflare applies its own default
	# and caches the HTML. The result was a visitor being served an old version of the site: they
	# clicked, the page did not move, and only a hard reload showed the truth. Setting it here
	# means it cannot depend on each app remembering, and a new app cannot reintroduce it.
	header Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"

	# Build assets are the exception, and the only one. Their names carry a content hash, so the
	# bytes behind a name never change and they may be cached as hard as anything can be. This is
	# what keeps the site fast while every page stays uncacheable.
	@immutable path /_next/static/* /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
		# The app generates canonical URLs from OZITUMA_SITE_URL, so the
		# forwarded host is for logs and any host-conditional logic.
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}
}

# ---------------------------------------------------------------------------
# The archive — ozikoro.com
#
# A second site on the same proxy, the same certificate and the same container network. It is the
# project the other two belong to, and it is served from the same database they are.
# ---------------------------------------------------------------------------

# www redirects to the apex, as the dictionary does, so there is one address for the archive.
www.{$OZIKORO_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	redir https://{$OZIKORO_DOMAIN}{uri} permanent
}

{$OZIKORO_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@health path /api/health
	header @health Cache-Control "no-store"

	# As for the dictionary: no page may be cached at the edge. The archive sends `no-store` itself, and
	# this makes it not depend on the app remembering — which is the failure the note above records.
	header Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"

	# Build assets are the exception, and the only one.
	@immutable path /_next/static/* /assets/* /fonts/* /design/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy ozikoro:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}
}

# ---------------------------------------------------------------------------
# The Academy — academy.ozikoro.com
#
# The learning layer, and the successor to learn.ozituma.com. A third site on the same proxy, the
# same certificate and the same container network.
#
# NO `www` BLOCK, AND THAT IS THE SAME DECISION THE RETIRED COURSES HOST MADE. A course address is
# something a learner is handed; a second spelling of it that redirects would only ever be a way for
# a shared link to look wrong.
#
# THE CERTIFICATE DOES NOT YET NAME THIS HOST, AND THAT IS A KNOWN GAP RATHER THAN AN OVERSIGHT.
# /opt/ozituma/certs/origin.pem is issued for *.ozituma.com and ozituma.com. Cloudflare's zone is on
# `full` today, which does not validate the origin certificate, so this serves — but it is the same
# state ozikoro.com is in for the same reason, and it stops being safe the moment anybody raises the
# zone to `full (strict)`. The fix is one Origin CA certificate naming *.ozikoro.com, placed beside
# this one and referenced here; until then, do not raise the zone.
# ---------------------------------------------------------------------------
{$ACADEMY_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# No page may be cached at the edge. The Academy sends no Cache-Control of its own, and an origin
	# that says nothing lets Cloudflare apply its own default and cache the HTML — the failure the
	# dictionary's notes record, where a visitor is served an old page and only a hard reload shows
	# the truth.
	header Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"

	# Build assets are the exception, and the only one. Nitro writes the client bundle to
	# `.output/public/assets/`, and every name carries a content hash.
	@immutable path /assets/* /brand/* /favicon.svg /favicon.ico /apple-touch-icon.png
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy academy:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}
}
