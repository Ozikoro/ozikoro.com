# ---------------------------------------------------------------------------
# Secrets. The tracked .env holds only the Supabase URL and PUBLISHABLE key,
# which are public by design and governed by row level security. The service
# role key bypasses RLS entirely, so it must never reach this file.
#
# SUPABASE_SERVICE_ROLE_KEY  ->  .env.local (developer) / `wrangler secret put` (production)
# PAYSTACK_SECRET_KEY        ->  same
# ---------------------------------------------------------------------------
.env.local
.env.*.local
.dev.vars
.wrangler
