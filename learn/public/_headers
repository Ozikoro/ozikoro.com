# Cache policy for static files. The HTML is NOT here — it is generated by the Worker and its
# policy is set in src/server.ts, because these rules only apply to files served from the assets
# binding.
#
# The bug this project had: nothing set a Cache-Control on the page, so browsers cached it
# heuristically and served a stale site until you clicked. Assets were always fine.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/keyboards/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
