{
  "name": "@ozituma/db",
  "version": "0.1.0",
  "private": true,
  "description": "Ozituma database: portable Postgres schema, migrations, and the corpus import pipeline.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./repository": "./src/repository.ts",
    "./apikeys": "./src/apikeys.ts",
    "./accounts": "./src/accounts.ts",
    "./passwords": "./src/passwords.ts",
    "./contributions": "./src/contributions.ts",
    "./donations": "./src/donations.ts",
    "./storage": "./src/storage.ts",
    "./practice": "./src/practice.ts",
    "./learn": "./src/learn.ts",
    "./learn-exercises": "./src/learn-exercises.ts",
    "./learn-practice": "./src/learn-practice.ts",
    "./learn-srs": "./src/learn-srs.ts",
    "./dashboard": "./src/dashboard.ts",
    "./clans": "./src/clans.ts",
    "./account-keys": "./src/account-keys.ts",
    "./admin": "./src/admin.ts"
  },
  "scripts": {
    "migrate": "node src/migrate.ts up",
    "migrate:down": "node src/migrate.ts down",
    "reset": "node src/migrate.ts reset",
    "seed": "node src/migrate.ts seed",
    "import:igbo": "node src/import/igbo.ts",
    "verify": "node src/verify.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node src/smoke.ts",
    "accounts": "node src/role.ts",
    "test:contributions": "node src/test-contributions.ts",
    "import:ibodict": "node src/import/ibodict.ts",
    "import:examples": "node src/import/examples.ts",
    "test:practice": "node src/test-practice.ts",
    "test:learn": "node src/test-learn.ts",
    "test:srs": "node src/test-srs.ts",
    "import:learn": "node src/import/learn-curriculum.ts",
    "test:headword-audio": "node src/test-headword-audio.ts",
    "test:proverb-rendering": "node src/test-proverb-rendering.ts",
    "test:donations": "node src/test-donations.ts",
    "import:yoruba": "node src/import/yoruba.ts",
    "import:text": "node src/import/text-dictionary.ts",
    "import:names": "node src/import/names.ts",
    "import:names-corpus": "node src/import/names-corpus.ts",
    "import:script": "node src/import/script.ts",
    "dedupe:words": "node src/import/dedupe.ts",
    "import:proverbs": "node src/import/proverbs.ts",
    "prune:empty": "node src/import/prune-empty.ts",
    "import:word-additions": "node src/import/word-additions.ts",
    "link:dialects": "node src/import/link-dialect-cognates.ts",
    "restore:relations": "node src/import/restore-pruned-relations.ts",
    "prune:unsettled-renderings": "node src/import/unsettled-renderings.ts",
    "restore:headword-audio": "node src/import/restore-headword-audio.ts",
    "test:name-corrections": "node src/test-name-corrections.ts",
    "apply:name-corrections": "node src/import/name-corrections.ts",
    "test:entry-edits": "node src/test-entry-edits.ts",
    "test:accounts": "node src/test-accounts.ts",
    "test:passwords": "node src/test-passwords.ts",
    "test:clan-search": "node src/test-clan-search.ts",
    "test:admin": "node src/test-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@ozituma/core": "*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "typescript": "^5.7.2"
  }
}
