{
  "name": "@ozikoro/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Ozikoro \u2014 the platform layer for ozikoro.com: the Spotify connection, and the podcast pipeline that will use it.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chunking": "./src/chunking.ts",
    "./spotify": "./src/spotify.ts",
    "./connection": "./src/connection.ts",
    "./archive": "./src/archive.ts",
    "./content": "./src/content.ts",
    "./media": "./src/media.ts",
    "./media-key": "./src/media-key.ts",
    "./media-bytes": "./src/media-bytes.ts",
    "./missing-figure": "./src/missing-figure.ts",
    "./members": "./src/members.ts",
    "./roles": "./src/roles.ts",
    "./users": "./src/users.ts",
    "./editorial": "./src/editorial.ts",
    "./audit": "./src/audit.ts",
    "./publications": "./src/publications.ts",
    "./publication-files": "./src/publication-files.ts",
    "./entity-graph": "./src/entity-graph.ts",
    "./follows": "./src/follows.ts",
    "./comments": "./src/comments.ts",
    "./rights": "./src/rights.ts",
    "./search": "./src/search.ts",
    "./entities": "./src/entities.ts",
    "./seo": "./src/seo.ts",
    "./redirects": "./src/redirects.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts src/pdf/*.test.ts",
    "test:archive": "node src/test-archive.ts",
    "test:connection": "node src/test-connection.ts",
    "import:wordpress": "node src/import/wordpress.ts",
    "import:archive": "node src/import/archive.ts",
    "verify": "node src/verify.ts",
    "test:members": "node src/test-members.ts",
    "test:editorial": "node src/test-editorial.ts",
    "test:authoring": "node src/test-authoring.ts",
    "test:trash": "node src/test-trash.ts",
    "test:seo-records": "node src/test-seo-records.ts",
    "test:publications": "node src/test-publications.ts",
    "import:media-store": "node src/import/media-store.ts",
    "test:rights": "node src/test-rights.ts",
    "test:institutional-access": "node src/test-institutional-access.ts",
    "test:search": "node src/test-search.ts",
    "import:media-upload": "node src/import/media-upload.ts",
    "backup": "node src/ops/backup.ts",
    "test:redirects": "node src/test-redirects.ts",
    "test:graph": "node src/test-graph.ts",
    "check:residue": "node src/ops/residue-check.ts",
    "check:capabilities": "node src/ops/capability-check.ts",
    "test:pronunciation": "node src/test-pronunciation.ts",
    "test:planner": "node src/test-planner.ts",
    "test:seo-verification": "node --test src/seo-verification.test.ts"
  },
  "dependencies": {
    "@ozituma/db": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
